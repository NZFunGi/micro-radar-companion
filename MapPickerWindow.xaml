<Window x:Class="MicroRadarCompanion.MapPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Pick Location" Height="600" Width="640"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <wv2:WebView2 x:Name="MapWebView" Grid.Row="0"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12">
            <TextBlock x:Name="StatusText" Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
            <Button x:Name="UseLocationButton" Content="Use this location" Width="140" Click="UseLocation_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
